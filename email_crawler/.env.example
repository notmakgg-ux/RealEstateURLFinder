# =============================================================================
# EMAIL CRAWLER CONFIGURATION
# =============================================================================

# Google Sheets Integration (REQUIRED)
# Path to your Google service account JSON key file
GOOGLE_SA_KEY_PATH=config/google_service_account.json
# Your Google Spreadsheet ID (get from the URL)
# https://docs.google.com/spreadsheets/d/{THIS_PART}/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Concurrency
MAX_CONCURRENT_REQUESTS=50
MAX_CONCURRENT_PER_DOMAIN=3

# HTTP Settings
HTTP_TIMEOUT=20
HTTP_FOLLOW_REDIRECTS=true

# Crawl Limits
MAX_PRIORITY_PAGES=30
MAX_AGENT_PAGES=20
MAX_TOTAL_PAGES_PER_DOMAIN=50

# Playwright Fallback
ENABLE_PLAYWRIGHT_FALLBACK=true

# Retries
MAX_RETRIES=3
RETRY_BACKOFF=2

# Confidence Scoring Thresholds
CONFIDENCE_EXCELLENT=90
CONFIDENCE_HIGH=75
CONFIDENCE_MEDIUM=50

# Optional: LLM Configuration (for ambiguous role classification)
# OPENAI_API_KEY=
# ENABLE_LLM_CLASSIFIER=false
